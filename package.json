{
  "name": "schedio",
  "displayName": "Schedio",
  "version": "0.0.1",
  "description": "Highlight text to create Google Calendar events instantly",
  "author": "gammatix",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "key": "",
    "permissions": [
      "identity",
      "storage",
      "contextMenus",
      "activeTab",
      "scripting"
    ],
    "host_permissions": [
      "https://*/*"
    ],
    "oauth2": {
      "client_id": "165377727521-94dq1ulvlq8gbelojbnpgqedg36psn4r.apps.googleusercontent.com",
      "scopes": [
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },
    "commands": {
      "create-event": {
        "suggested_key": {
          "default": "Ctrl+Shift+S",
          "mac": "Command+Shift+S"
        },
        "description": "Create event from selected text"
      }
    }
  }
}
